// Waybar config - Tokyo Night
// Location: ~/.config/waybar/config.jsonc
// Icons are Nerd Font glyphs written as \uXXXX escapes so they survive copy/paste.
{
    "layer": "top",
    "position": "top",
    "height": 34,

    // Match Hyprland's outer gaps (12) so the bar lines up with your windows
    "margin-top": 6,
    "margin-left": 12,
    "margin-right": 12,
    "spacing": 6,

    // Re-apply style.css automatically whenever you save it
    "reload_style_on_change": true,

    "modules-left":   ["hyprland/workspaces"],
    "modules-center": ["clock"],
    "modules-right":  ["tray", "pulseaudio", "network", "cpu", "memory"],

        "hyprland/workspaces": {
        "format": "{icon}",
        "format-icons": {
            "1": "一",
            "2": "二",
            "3": "三",
            "4": "四",
            "5": "五",
            "6": "六",
            "7": "七",
            "8": "八",
            "9": "九",
            "10": "十"
        },
        "persistent-workspaces": {
            "*": 5
        }
    },

    "clock": {
        "format": "\uf017  {:%I:%M %p}",
        // Click the clock to toggle to the date
        "format-alt": "\uf073  {:%A, %B %d}",
        "tooltip-format": "<tt>{calendar}</tt>"
    },

    "pulseaudio": {
        "format": "\uf028  {volume}%",
        "format-muted": "\uf026  muted",
        "scroll-step": 5,
        "on-click": "pavucontrol"
    },

    "network": {
        "format-ethernet": "\uf0e8  wired",
        "format-wifi": "\uf1eb  {essid}",
        "format-disconnected": "\uf127  offline",
        "tooltip-format": "{ifname}: {ipaddr}"
    },

    "cpu": {
        "format": "\uf2db  {usage}%",
        "interval": 2
    },

    "memory": {
        "format": "\uf233  {percentage}%",
        "interval": 5
    },

    "tray": {
        "spacing": 8
    }
}
