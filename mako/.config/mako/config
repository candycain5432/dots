# Mako notifications - Crimson Temple
# Location: ~/.config/mako/config

font=JetBrainsMono Nerd Font 11

background-color=#131314e6
text-color=#d8d4ce
border-color=#2c3335
progress-color=over #5c0f2a

border-size=2
border-radius=10
padding=12
margin=12
width=350
height=150

anchor=top-right
default-timeout=5000
max-visible=5
icons=1
max-icon-size=48

# Normal notifications: calm grey border; red is saved for things that matter
[urgency=low]
border-color=#2c3335
text-color=#8a8681

[urgency=high]
border-color=#e9445e
default-timeout=0
