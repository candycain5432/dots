{
    "workbench.colorTheme": "Impasto",
    "workbench.iconTheme": "material-icon-theme",
    "editor.fontFamily": "'JetBrainsMono Nerd Font Mono', monospace",
    "editor.fontSize": 14,
    "editor.fontLigatures": true,
    "terminal.integrated.fontFamily": "'JetBrainsMono Nerd Font Mono', monospace",
    "window.titleBarStyle": "custom",
    "editor.minimap.enabled": false,
    "editor.cursorBlinking": "smooth",
    "editor.cursorSmoothCaretAnimation": "on",
    "editor.smoothScrolling": true,
    "editor.renderLineHighlight": "all",
    "editor.semanticHighlighting.enabled": false,
    "workbench.colorCustomizations": {
        "editor.background": "#131314",
        "editor.foreground": "#d8d4ce",
        "editor.lineHighlightBackground": "#1d2224",
        "editor.selectionBackground": "#5c0f2a99",
        "editor.selectionHighlightBackground": "#5c0f2a55",
        "editor.findMatchBackground": "#b11d4388",
        "editor.findMatchHighlightBackground": "#5c0f2a66",
        "editorCursor.foreground": "#e9445e",
        "editorLineNumber.foreground": "#4a5255",
        "editorLineNumber.activeForeground": "#e9445e",
        "editorIndentGuide.background1": "#1d2224",
        "editorIndentGuide.activeBackground1": "#2c3335",
        "editorBracketMatch.border": "#e9445e",
        "editorWhitespace.foreground": "#2c3335",
        "editorWidget.background": "#1d2224",
        "editorWidget.border": "#2c3335",
        "editorSuggestWidget.background": "#1d2224",
        "editorSuggestWidget.selectedBackground": "#2c3335",
        "editorSuggestWidget.highlightForeground": "#e9445e",
        "editorError.foreground": "#e9445e",
        "editorWarning.foreground": "#d6a36a",
        "editorInfo.foreground": "#7f95a8",
        "editorGutter.addedBackground": "#9aab8f",
        "editorGutter.modifiedBackground": "#d6a36a",
        "editorGutter.deletedBackground": "#e9445e",
        "titleBar.activeBackground": "#131314",
        "titleBar.activeForeground": "#d8d4ce",
        "titleBar.inactiveBackground": "#131314",
        "titleBar.inactiveForeground": "#8a8681",
        "activityBar.background": "#131314",
        "activityBar.foreground": "#e9445e",
        "activityBar.inactiveForeground": "#8a8681",
        "activityBar.activeBorder": "#e9445e",
        "activityBarBadge.background": "#e9445e",
        "activityBarBadge.foreground": "#131314",
        "sideBar.background": "#131314",
        "sideBar.foreground": "#d8d4ce",
        "sideBar.border": "#1d2224",
        "sideBarSectionHeader.background": "#1d2224",
        "sideBarTitle.foreground": "#8a8681",
        "statusBar.background": "#131314",
        "statusBar.foreground": "#8a8681",
        "statusBar.border": "#1d2224",
        "statusBar.debuggingBackground": "#b11d43",
        "statusBar.noFolderBackground": "#131314",
        "statusBarItem.remoteBackground": "#e9445e",
        "statusBarItem.remoteForeground": "#131314",
        "panel.background": "#131314",
        "panel.border": "#2c3335",
        "panelTitle.activeBorder": "#e9445e",
        "panelTitle.activeForeground": "#d8d4ce",
        "editorGroupHeader.tabsBackground": "#131314",
        "tab.activeBackground": "#1d2224",
        "tab.activeForeground": "#d8d4ce",
        "tab.activeBorderTop": "#e9445e",
        "tab.inactiveBackground": "#131314",
        "tab.inactiveForeground": "#8a8681",
        "tab.border": "#131314",
        "focusBorder": "#e9445e88",
        "list.activeSelectionBackground": "#2c3335",
        "list.activeSelectionForeground": "#f0ece6",
        "list.inactiveSelectionBackground": "#1d2224",
        "list.hoverBackground": "#1d2224",
        "list.highlightForeground": "#e9445e",
        "input.background": "#1d2224",
        "input.border": "#2c3335",
        "input.foreground": "#d8d4ce",
        "inputOption.activeBorder": "#e9445e",
        "button.background": "#e9445e",
        "button.foreground": "#131314",
        "button.hoverBackground": "#f06a80",
        "badge.background": "#e9445e",
        "badge.foreground": "#131314",
        "progressBar.background": "#e9445e",
        "scrollbarSlider.background": "#2c333588",
        "scrollbarSlider.hoverBackground": "#2c3335",
        "scrollbarSlider.activeBackground": "#4a5255",
        "gitDecoration.modifiedResourceForeground": "#d6a36a",
        "gitDecoration.untrackedResourceForeground": "#9aab8f",
        "gitDecoration.deletedResourceForeground": "#e9445e",
        "gitDecoration.ignoredResourceForeground": "#4a5255",
        "terminal.background": "#131314",
        "terminal.foreground": "#d8d4ce",
        "terminalCursor.foreground": "#e9445e",
        "terminal.ansiBlack": "#2c3335",
        "terminal.ansiBrightBlack": "#4a5255",
        "terminal.ansiRed": "#e9445e",
        "terminal.ansiBrightRed": "#f06a80",
        "terminal.ansiGreen": "#9aab8f",
        "terminal.ansiBrightGreen": "#b3c2a8",
        "terminal.ansiYellow": "#d6a36a",
        "terminal.ansiBrightYellow": "#e4bd8c",
        "terminal.ansiBlue": "#7f95a8",
        "terminal.ansiBrightBlue": "#9cb0c1",
        "terminal.ansiMagenta": "#c45c7c",
        "terminal.ansiBrightMagenta": "#d77f9a",
        "terminal.ansiCyan": "#8fb0ad",
        "terminal.ansiBrightCyan": "#aac7c4",
        "terminal.ansiWhite": "#d8d4ce",
        "terminal.ansiBrightWhite": "#f0ece6"
    },
    "editor.tokenColorCustomizations": {
        "comments": "#8a8681",
        "strings": "#d6a36a",
        "keywords": "#e9445e",
        "numbers": "#c45c7c",
        "functions": "#9aab8f",
        "types": "#7f95a8",
        "variables": "#d8d4ce",
        "textMateRules": [
            {
                "scope": [
                    "comment",
                    "punctuation.definition.comment"
                ],
                "settings": {
                    "fontStyle": "italic"
                }
            },
            {
                "scope": [
                    "storage.type",
                    "storage.modifier",
                    "keyword.control"
                ],
                "settings": {
                    "foreground": "#e9445e"
                }
            },
            {
                "scope": [
                    "constant.language",
                    "constant.numeric",
                    "support.constant"
                ],
                "settings": {
                    "foreground": "#c45c7c"
                }
            },
            {
                "scope": [
                    "entity.name.class",
                    "entity.name.type",
                    "support.class"
                ],
                "settings": {
                    "foreground": "#7f95a8",
                    "fontStyle": "bold"
                }
            },
            {
                "scope": [
                    "variable.parameter"
                ],
                "settings": {
                    "foreground": "#8fb0ad",
                    "fontStyle": "italic"
                }
            },
            {
                "scope": [
                    "keyword.operator",
                    "punctuation"
                ],
                "settings": {
                    "foreground": "#8a8681"
                }
            },
            {
                "scope": [
                    "entity.name.tag"
                ],
                "settings": {
                    "foreground": "#e9445e"
                }
            },
            {
                "scope": [
                    "entity.other.attribute-name"
                ],
                "settings": {
                    "foreground": "#d6a36a",
                    "fontStyle": "italic"
                }
            }
        ]
    },
    "window.menuBarVisibility": "compact",
    "workbench.statusBar.visible": false,
    "workbench.activityBar.compact": true,
    "workbench.navigationControl.enabled": false,
    "workbench.layoutControl.enabled": false,
    "workbench.browser.showInTitleBar": false,
    "workbench.editor.enablePreview": false,
    "workbench.productIconTheme": "fluent-icons",
    "debug.console.fontFamily": "'JetBrainsMono Nerd Font Mono', monospace",
    "editor.lineHeight": 1.6,
    "terminal.integrated.fontSize": 13,
    "scm.inputFontFamily": "editor",
    "workbench.activityBar.location": "top",
    "window.commandCenter": false,
    "chat.commandCenter.enabled": false,
    "breadcrumbs.enabled": false,
    "workbench.startupEditor": "none",
    "explorer.compactFolders": false,
    "workbench.tree.indent": 14,
    "editor.padding.top": 16,
    "editor.padding.bottom": 16,
    "workbench.list.smoothScrolling": true,
    "terminal.integrated.smoothScrolling": true,
    "editor.stickyScroll.enabled": true,
    "editor.bracketPairColorization.enabled": true,
    "editor.guides.bracketPairs": "active",
    "editor.renderWhitespace": "trailing",
    "editor.linkedEditing": true,
    "editor.overviewRulerBorder": false,
    "errorLens.messageBackgroundMode": "message",
    "errorLens.fontStyleItalic": true,
    "errorLens.gutterIconsEnabled": false,
    "indentRainbow.indicatorStyle": "light",
    "indentRainbow.lightIndicatorStyleLineWidth": 1,
    "material-icon-theme.folders.color": "#116A92",
    "indentRainbow.colors": ["#1795cd40", "#f9e2af40", "#89b4fa40", "#a6e3a140", "#2594c740"],
    "indentRainbow.errorColor": "#f38ba840"
}
